
def double(number):
"""Return the number doubled."""
    return number * 2


def is_pass(score):
"""Return True if the score is a pass."""
    return score >= 50


def greet(name, greeting="Hello"):
"""Return a greeting for a name, defaulting to Hello."""
    return greeting + ", " + name + "!"


print(double(7))
print(double(10))
print(is_pass(80))
print(is_pass(20))
print(greet("KAKA"))
print(greet("ALI", "Habari"))
